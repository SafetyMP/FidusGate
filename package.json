{
  "name": "fidusgate-root",
  "version": "1.8.2",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.5",
    "deepmerge-ts": "8.0.2",
    "ip-address": "10.3.1",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "proxy-addr": "2.0.8",
    "undici@>=7.0.0 <8.0.0": "7.29.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "seed:receipts:repair": "node apps/secure-gateway/dist/repair-development-receipts.js",
    "build": "turbo run build",
    "build:wasm": "node scripts/build-wasm.js",
    "test": "turbo run test",
    "lint": "biome check apps/admin-dashboard/build apps/admin-dashboard/src/discovery.test.ts apps/admin-dashboard/src/lib apps/admin-dashboard/src/hooks apps/admin-dashboard/src/components apps/admin-dashboard/src/connected apps/admin-dashboard/src/tabs/LedgerTab.tsx apps/secure-gateway/src/routes apps/secure-gateway/src/development-receipts.ts apps/secure-gateway/src/development-receipts.test.ts apps/secure-gateway/src/repair-development-receipts.ts packages/database/src/development-receipts.test.ts apps/secure-gateway/src/middleware packages/core-types/src/index.ts && turbo run lint",
    "ci": "bash scripts/ci-verify.sh",
    "bootstrap": "node scripts/build-wasm.js && bash scripts/bootstrap.sh",
    "sandbox": "bash scripts/sandbox-execute.sh",
    "memory:context": "node scripts/get-learning-context.js",
    "policy:dry-run": "node scripts/dry-run-policy.js",
    "release": "semantic-release",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:rebuild-gif": "node scripts/capture-screenshots.mjs --from-existing"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "browserslist": "4.28.9",
    "gifenc": "^1.0.3",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "semantic-release": "^25.0.8",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  },
  "description": "Reference MCP policy gateway and receipt-first console with Cedar authorization and Ed25519-signed receipts.",
  "homepage": "https://safetymp.github.io/FidusGate/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SafetyMP/FidusGate.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "cedar",
    "ed25519",
    "authorization",
    "audit-trail",
    "ai-agents"
  ]
}
