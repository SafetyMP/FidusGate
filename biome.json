{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "apps/admin-dashboard/src/lib/**",
      "apps/admin-dashboard/src/hooks/**",
      "apps/admin-dashboard/src/components/**",
      "apps/admin-dashboard/src/tabs/LedgerTab.tsx",
      "apps/secure-gateway/src/routes/**",
      "apps/secure-gateway/src/middleware/**",
      "packages/core-types/src/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "complexity": {
        "noForEach": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
